# Copy this file to .env (in hw4/ or hw4/backend/) and fill in your own values.
# Never commit your real .env or share your API key. .env is git-ignored.

# Portkey key used for every AI call (OpenAI models through Portkey).
PORTKEY_API_KEY=your-portkey-api-key-here
PORTKEY_BASE_URL=https://api.portkey.ai/v1
PORTKEY_PROVIDER=openai
MODEL_NAME=gpt-5.6-luna

# Optional: a long random string that signs login tokens.
# If left empty, one is generated on first start and saved in backend/.session_secret (git-ignored).
SESSION_SECRET=

# Optional: where the local data pack lives (default: hw4/data).
# CAMPUS_CUSTOMS_DATA=/path/to/data
